{
  "rewrites": [
    {
      "source": "/feed/signal.json",
      "destination": "https://jungnang-policy-media.goodmorninghope.chatgpt.site/data.json"
    },
    {
      "source": "/feed/stats.json",
      "destination": "https://jungnang-policy-media.goodmorninghope.chatgpt.site/archive-stats.json"
    },
    {
      "source": "/feed/aa/catalog.js",
      "destination": "https://jungnang-agungi-archive.goodmorninghope.chatgpt.site/catalog.js"
    },
    {
      "source": "/feed/chok/:file",
      "destination": "https://raw.githubusercontent.com/goodmorninghope-khs/jungnang-signal/main/inbox/chok/:file"
    }
  ],
  "headers": [
    {
      "source": "/feed/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=600, stale-while-revalidate=3600"
        }
      ]
    }
  ]
}